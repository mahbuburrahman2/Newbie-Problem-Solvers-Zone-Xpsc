{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C++17",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
